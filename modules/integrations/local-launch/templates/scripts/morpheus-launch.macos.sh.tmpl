#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

load_env() {
  local file="$1"
  if [[ -f "$file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$file"
    set +a
  fi
}

load_env "$ROOT_DIR/.env"
load_env "$ROOT_DIR/.env.local"
load_env "$ROOT_DIR/.env.macos"

MODE="${MORPHEUS_LAUNCH_MODE:-fullstack}"
BACKEND_DIR="${MORPHEUS_BACKEND_DIR:-}"
FRONTEND_DIR="${MORPHEUS_FRONTEND_DIR:-}"
BACKEND_COMMAND="${MORPHEUS_BACKEND_COMMAND:-}"
FRONTEND_COMMAND="${MORPHEUS_FRONTEND_COMMAND:-}"
DRY_RUN="${MORPHEUS_DRY_RUN:-false}"

run_cmd() {
  local label="$1"
  local dir="$2"
  local cmd="$3"
  if [[ -z "$dir" || -z "$cmd" ]]; then
    echo "[morpheus-launch] skip ${label}: directory or command not configured"
    return 0
  fi
  echo "[morpheus-launch] ${label}: cd ${dir} && ${cmd}"
  if [[ "$DRY_RUN" == "true" ]]; then
    return 0
  fi
  (cd "$ROOT_DIR/$dir" && eval "$cmd") &
}

case "$MODE" in
  backend-only)
    run_cmd "backend" "$BACKEND_DIR" "$BACKEND_COMMAND"
    ;;
  frontend-only)
    run_cmd "frontend" "$FRONTEND_DIR" "$FRONTEND_COMMAND"
    ;;
  fullstack|*)
    run_cmd "backend" "$BACKEND_DIR" "$BACKEND_COMMAND"
    run_cmd "frontend" "$FRONTEND_DIR" "$FRONTEND_COMMAND"
    ;;
esac

if [[ "$DRY_RUN" == "true" ]]; then
  echo "[morpheus-launch] dry run complete"
else
  wait
fi