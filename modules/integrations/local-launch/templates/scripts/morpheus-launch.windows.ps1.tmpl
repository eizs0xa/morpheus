param(
  [switch]$DryRun
)

$ErrorActionPreference = "Stop"
$RootDir = Resolve-Path (Join-Path $PSScriptRoot "..\..")

function Import-MorpheusEnv($Path) {
  if (Test-Path $Path) {
    Get-Content $Path | ForEach-Object {
      if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
      $parts = $_ -split '=', 2
      [Environment]::SetEnvironmentVariable($parts[0].Trim(), $parts[1].Trim(), 'Process')
    }
  }
}

Import-MorpheusEnv (Join-Path $RootDir ".env")
Import-MorpheusEnv (Join-Path $RootDir ".env.local")
Import-MorpheusEnv (Join-Path $RootDir ".env.windows")

$Mode = $env:MORPHEUS_LAUNCH_MODE
if (-not $Mode) { $Mode = "fullstack" }

function Start-MorpheusProcess($Label, $Dir, $Command) {
  if (-not $Dir -or -not $Command) {
    Write-Host "[morpheus-launch] skip $Label: directory or command not configured"
    return
  }
  $FullDir = Join-Path $RootDir $Dir
  Write-Host "[morpheus-launch] $Label: cd $FullDir && $Command"
  if ($DryRun) { return }
  Start-Process powershell -ArgumentList @('-NoExit', '-Command', "cd '$FullDir'; $Command")
}

switch ($Mode) {
  "backend-only" { Start-MorpheusProcess "backend" $env:MORPHEUS_BACKEND_DIR $env:MORPHEUS_BACKEND_COMMAND }
  "frontend-only" { Start-MorpheusProcess "frontend" $env:MORPHEUS_FRONTEND_DIR $env:MORPHEUS_FRONTEND_COMMAND }
  default {
    Start-MorpheusProcess "backend" $env:MORPHEUS_BACKEND_DIR $env:MORPHEUS_BACKEND_COMMAND
    Start-MorpheusProcess "frontend" $env:MORPHEUS_FRONTEND_DIR $env:MORPHEUS_FRONTEND_COMMAND
  }
}

if ($DryRun) { Write-Host "[morpheus-launch] dry run complete" }