# Morpheus local launch configuration
# Copy values into .env.local or OS-specific overlays. Do not commit real secrets.

MORPHEUS_LAUNCH_MODE=fullstack
MORPHEUS_BACKEND_DIR=../backend
MORPHEUS_FRONTEND_DIR=../frontend
MORPHEUS_BACKEND_COMMAND=
MORPHEUS_FRONTEND_COMMAND=

# Auth/local testing
MORPHEUS_AUTH_PROVIDER=okta
MORPHEUS_LOCAL_AUTH_MODE=mock
MORPHEUS_OKTA_REDIRECT_URI=http://localhost:8000/login/callback